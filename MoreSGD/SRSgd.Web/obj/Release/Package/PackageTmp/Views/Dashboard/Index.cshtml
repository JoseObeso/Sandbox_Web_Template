                    for (let index = 0; index < data.length; index++) {
                        xValuesMes.push(data[index].I_dia);
                        yValuesTotal.push(data[index].I_total);
                }
            GraficoGenerado2(xValuesMes, yValuesTotal, "line");
                },

            error: function (e) {
