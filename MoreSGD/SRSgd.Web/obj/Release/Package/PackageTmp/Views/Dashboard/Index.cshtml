<div class="container-fluid">
    <div class="animated fadeIn">
        <div class="card-header text-left text-white bg-danger">
            <strong><font size=5 face="Arial">Reporte:Documentos emitidos del SGD</font></strong>
        </div>
        <div class="row">
            @*Total de documento emitidos*@
            <div class="col-sm-8 col-lg-2">
                <div class="card text-black bg-light">
                    <div class="card-body pb-0 mt-3 mx-3" style="height:160px;">
                        <div class="btn-group float-xl-right">
                            <button class="btn btn-secondary" type="button">
                                <i class="icon-chart"></i>
                            </button>
                        </div>
                        <span> Total documento</span>
                        <div>  emitidos </div>
                        <b><FONT FACE="Arial"><h1 id="totalEmitidos"></h1></FONT></b>
                    </div>
                </div>
            </div>


            @*total por estado*@
            <div class="col-sm-6 col-lg-4">
                <div class="card text-center  bg-light">
                        <strong><font size=2 face="Arial ">Total documentos emitidos por estado</font></strong>
                    <div class="chart-wrapper mt-3 mx-3" style="height:140px;">
                        <canvas class="chart" id="GraficoBarrasPorEstado" height="80"></canvas>
                    </div>
                </div>

            </div>

            @*4to.Grafico total por año*@
            <div class="col-sm-6 col-lg-4">
                <div class="card text-center  bg-light">
                    <strong><font size=2 face="Arial ">Total documentos emitidos por años</font></strong>
                    <div class="chart-wrapper mt-3 mx-3" style="height:140px;">
                        <canvas class="chart" id="GraficoBarrasPorAnno" height="80"></canvas>
                    </div>
                </div>
            </div>

            @*Total por tipo documento*@

            <div class="col-sm-6 col-lg-2">
                <div class="card text-center  bg-light">
                    <strong><font size=2 face="Arial ">Total por tipo de documentos</font></strong>
                    <div class="chart-wrapper mt-3 mx-3" style="height:140px;">
                        <canvas class="chart" id="GraficoBarrasPorTipoDocumento" height="80"></canvas>
                    </div>
                </div>
            </div>



        </div>
        <!-- /.row-->
        <div class="row">
            <div class="card bg-light col-sm-6 col-lg-8">
                <div class="card-body pb-0">
                    <div class="row">
                        <div class="col-sm-5 ">
                            <h5 class="card-title mb-0 text-danger">Documentos emitidos</h5>
                            <span id="tiempo_grafico"></span>
                            <div class="small text-muted"> <label id="lblToday"></label>  </div>
                        </div>
                        <!-- /.col-->
                        <div class="col-sm-7 d-none d-md-block text-right">
                            <button class="btn  bg-danger btn-xs" id="b01">Día</button>
                            <button class="btn  bg-danger btn-xs" id="b02">Mes</button>
                            <button class="btn  bg-danger btn-xs" id="b03">Año</button>
                        </div>
                    </div>
                    <div if="divMainChart" class="chart-wrapper" style="height:300px;margin-top:40px;">
                        <canvas class="chart" id="GraficoGeneradoChart" height="300"></canvas>
                    </div>
                </div>
            </div>

            @*5to.Grafico total por dependencia top 5*@
            <div class="col-sm-6 col-lg-4">
                <div class="card text-center  bg-light">
                    <strong><font size=2 face="Arial">Top 5: Total documentos emitidos por dependencia</font></strong>
                    <div class="chart-wrapper mt-3 mx-3" style="height:140px;">
                        <canvas class="chart" id="GraficoBarrasPorDependencia" height="80"></canvas>
                    </div>
                </div>

