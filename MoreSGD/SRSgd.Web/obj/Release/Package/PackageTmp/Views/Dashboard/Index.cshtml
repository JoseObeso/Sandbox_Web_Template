                }
            });


        }


        function total_documentoPorAnno() {
            $.ajax({
            type: 'GET',
            url: '@Url.Action("_PorAnio", "Dashboard")',
            contentType: 'application/json;charset=utf-8',
            dataType: "json",
                success: function (data) {
                    var xValuesAnio = [];
                var yValuesTotal = [];
                for (let index = 0; index < data.length; index++) {
                    xValuesAnio.push(data[index].I_anio);
                    yValuesTotal.push(data[index].I_total);
                }
                    crear_grafico_PorAnno(xValuesAnio, yValuesTotal, "line");
                },

            error: function (e) {
            //alert(e.statusText);
            }
            });


        }

        //total años de la pide
        function crear_grafico_PorAnioPIDE(ValorX, ValorY, TipoGrafico, Titulo) {
            var xValues = ValorX;
            var yValues = ValorY;
            
            var barColorsMes = ["#d9af07", "#37ab56", "#b04141", "#418db0", "#12120b", "#b8bf4d", "#abab48", "#abab48", "#abab48", "#f2f257", "#f2f257", "#bcbcbc", "#bcbcbc", "#bcbcbc", "#bcbcbc", "#bcbcbc"];
            new Chart("GraficoBarrasPorAnioPIDE", {
                type: 'pie',
                data: {
                    labels: xValues,
                    datasets: [{
                        label: 'Total documentos emitidos por Año (PIDE)',
                        borderColor: '#f5f5f2',
                        borderWidth: 1,
                        pointBorderColor: 'black',
                        pointBackgroundColor: 'black',
                        backgroundColor: barColorsMes,
                        data: yValues
                    }]
                },
                options: {
                    maintainAspectRatio: false,
                    legend: {
                        display: true,
                        position: 'top',
                        align: 'center',

                    },
                    title: {
                        display: false,
                        text: Titulo
                    },
                    pointRadius: 5,
                    scales: {
                        xAxes: [{
                            display: false,
                            gridLines: {
                                drawOnChartArea: false,

                            },
                            ticks: {
                                fontColor: "#72bfe8",
                                maxTicksLimit: 7

                            }
                        }],
                        yAxes: [{
                            display: false,
                            ticks: {
                                beginAtZero: true,
                                maxTicksLimit: 5,
                                fontColor: hexToRgba(getStyle('--info'), 10)
                            }
                        }]
                    },
                    elements: {
                        point: {
                            radius: 0,
                            hitRadius: 10,
                            hoverRadius: 4,
                            hoverBorderWidth: 3
                        }
                    }
                }
            });
        }



