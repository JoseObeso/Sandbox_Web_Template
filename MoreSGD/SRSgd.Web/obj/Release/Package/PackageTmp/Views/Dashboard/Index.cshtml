@{

    //ViewBag.Title = "Index";
    ViewData["Title"] = "SGD-INICIO";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script>

    var ln_tiempo = 1;

    $(document).ready(function () {
       
        documentos_generados(ln_tiempo);
        total_documentoPorAnno();
        total_documentoPorTipoDocumento();
        total_documentoPorEstado();
        total_documentosEmitidos();
        total_documentoPorDependencia();
        total_documentoPorAnioPIDE();

        $("#b01").click(function () {
            ln_tiempo = 1;
            documentos_generados(ln_tiempo);
          });

        $("#b02").click(function () {
            ln_tiempo = 2;
            documentos_generados(ln_tiempo);
        });

        $("#b03").click(function () {
            ln_tiempo = 3;
            documentos_generados(ln_tiempo);
        });

        function documentos_generados(ln_tiempo) {

            switch (ln_tiempo) {
                case 1:
                    mostrar_generados_por_dia();
                    $("#tiempo_grafico").html('<font size = "2"> Últimos 7 días</font>');
                    break;
                case 2:
                    mostrar_generados_por_mes();
                    $("#tiempo_grafico").html('<font size = "2">Últimos 30 días</font>');
                    break;
                case 3:
                    mostrar_generados_por_anio();
                    $("#tiempo_grafico").html('<font size="2">Últimos 12 meses</font>');
                    break;
                default:
                    break;
            }

        }

        function total_documentoPorAnioPIDE() {
            $.ajax({
            type: 'GET',
            url: '@Url.Action("_DocumentosTotalAnioPIDE", "Dashboard")',
            contentType: 'application/json;charset=utf-8',
            dataType: "json",
                success: function (data) {
                    var xValuesAnio = [];
                var yValuesTotal = [];
                for (let index = 0; index < data.length; index++) {
                    xValuesAnio.push(data[index].I_anio);
                    yValuesTotal.push(data[index].I_total);
                }
                    crear_grafico_PorAnioPIDE(xValuesAnio, yValuesTotal, "line");
                },

            error: function (e) {
            //alert(e.statusText);
            }
            });
        }



        function total_documentosEmitidos() {
             $.ajax({
                type: 'GET',
                url: '@Url.Action("_DocumentosTotalEmitidos", "Dashboard")',
                contentType: 'application/json;charset=utf-8',
                dataType: "json",
                 success: function (data) {
                     var ln_i_total = data.length;
                     if (ln_i_total == 0) {
                         $("#totalEmitidos").text("0");
                     }
                     else {
                         $("#totalEmitidos").text(data[0].I_total);

                     }
                },
                error: function (e) {
                    //alert(e.statusText);
                }
            });

        }

        function total_documentoPorDependencia() {
            $.ajax({
                type: 'GET',
                url: '@Url.Action("_PorDependencia", "Dashboard")',
                contentType: 'application/json;charset=utf-8',
                dataType: "json",
                success: function (data) {
                    var xValuesDep = [];
                    var yValuesTotal = [];
                    for (let index = 0; index < data.length; index++) {
                        xValuesDep.push(data[index].V_dep);
                        yValuesTotal.push(data[index].I_total);
                    }
                    crear_grafico_PorDependencia(xValuesDep, yValuesTotal, "bar", "Documentos Para Despacho");
                },
                error: function (e) {
                    //alert(e.statusText);
                }
            });
        }


        function total_documentoPorEstado() {
            $.ajax({
                type: 'GET',
                url: '@Url.Action("_PorEstado", "Dashboard")',
                contentType: 'application/json;charset=utf-8',
                dataType: "json",
                success: function (data) {
                    var xValuesDoc = [];
                    var yValuesTotal = [];
                    for (let index = 0; index < data.length; index++) {
                        xValuesDoc.push(data[index].V_doc);
                        yValuesTotal.push(data[index].I_total);
                    }
                    crear_grafico_PorEstado(xValuesDoc, yValuesTotal, "bar", "Documentos Para Despacho");
                },
                error: function (e) {
                    //alert(e.statusText);
                }
            });
        }



        function total_documentoPorTipoDocumento() {
            $.ajax({
                type: 'GET',
                url: '@Url.Action("_PorTipoDocumento", "Dashboard")',
                contentType: 'application/json;charset=utf-8',
                dataType: "json",
                success: function (data) {
                    var xValuesDoc = [];
                    var yValuesTotal = [];
                    for (let index = 0; index < data.length; index++) {
                        xValuesDoc.push(data[index].V_doc);
                        yValuesTotal.push(data[index].I_total);
                    }
                    crear_grafico_PorTipoDocumento(xValuesDoc, yValuesTotal, "bar", "Documentos Para Despacho");
