
@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="es">
<head>

    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width" />

    <title>Consulta por expediente - SGD</title>
    <link href="/@("lib/coreui/node_modules/@coreui/icons/css/coreui-icons.min.css")" rel="stylesheet" />
    <link href="~/lib/coreui/node_modules/flag-icon-css/css/flag-icon.min.css" rel="stylesheet" />
    <link href="~/lib/coreui/node_modules/font-awesome/css/font-awesome.min.css" rel="stylesheet" />
    <link href="~/lib/coreui/node_modules/simple-line-icons/css/simple-line-icons.css" rel="stylesheet" />

    <link href="~/lib/coreui/css/style.css" rel="stylesheet" />
    <link href="~/lib/coreui/vendors/pace-progress/css/pace.min.css" rel="stylesheet" />
    <script async="" src="https://www.googletagmanager.com/gtag/js?id=UA-118965717-3"></script>

    <script src="~/lib/coreui/node_modules/jquery/dist/jquery.min.js"></script>
    <script type="module" src="~/lib/coreui/node_modules/popper.js/dist/popper.min.js"></script>
    <script src="~/lib/coreui/node_modules/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="~/lib/coreui/node_modules/pace-progress/pace.min.js"></script>
    <script src="~/lib/coreui/node_modules/perfect-scrollbar/dist/perfect-scrollbar.min.js"></script>
    <script src="~/@("lib/coreui/node_modules/@coreui/coreui/dist/js/coreui.min.js")"></script>
    <script src="~/Scripts/sweetalert.js"></script>
    <script type="text/javascript">
        window.dataLayer = window.dataLayer || [];

        function gtag() {
            dataLayer.push(arguments);
        }
        gtag('js', new Date());
        gtag('config', 'UA-118965717-3');
        gtag('config', 'UA-118965717-5');


        async function fetchPost(url, tiporespuesta, frm, callback) {
            try {
                var raiz = document.getElementById("hdfOculto").value;
                document.getElementById("divLoading").style.display = "block";
                //http://localhost........
                var urlCompleta = window.location.protocol + "//" + window.location.host + "/" + raiz + url
                var res = await fetch(urlCompleta, {
                    method: "POST",
                    body: frm
                });
                if (tiporespuesta == "json")
                    res = await res.json();
                else if (tiporespuesta == "text")
                    res = await res.text();
                callback(res)
                document.getElementById("divLoading").style.display = "none";

            } catch (e) {
                console.log(e)
                alert("Ocurrion un error");
                document.getElementById("divLoading").style.display = "none";
            }
        }


        $(document).ready(function () {

            $("#txtUsuario").val('');

            $("#btnLogin").click(function () {
                var usuario = document.getElementById("txtUsuario").value.trim();
                var contra = document.getElementById("txtPassword").value.trim();
                if (usuario == "") {
                    alert("Debe ingresar su usuario del Sistema Integrado");
                    return;
                }
                if (contra == "") {
                    alert("Debe ingresar su contraseña");
                    return;
                }
                var frm = new FormData();
                frm.append("usuario", usuario)
                frm.append("contra", contra)
                fetchPost("Login/valigarlogin", "text", frm, function (rpta) {
                    if (rpta == 0) {
                        alert("Usuario o contraseña incorrecta");
                    }
                    else if (rpta == -1) {
                        alert("No tiene acceso al aplicativo consulta expediente, consulte a la Oficina de Informatica")
                    } else if (rpta == -2) {
                        alert("No se encuentra el archivo que indica quienes pueden ingresar y quienes no");
                    }
                    else {
                        //alert("Bienvenido al sistema");
                        document.location.href = "/Dashboard/Index"
                    }
                })
            });
            $("#txtUsuario").on('keydown', function (e) {

            });

            $("#txtPassword").click(function () {
                var lc_user = $("#txtUsuario").val();
                   $.ajax({
                        type: 'GET',
                        url: '@Url.Action("FiltroDependencia", "Login")',
                        data: {
                            pUsuario: lc_user,
                            pCodEmp: ''
                        },
                        dataType: 'json',
                        success: function (data) {
                            $("#selDependencia").empty();//html('$nbsp;');
                            if (data != null) {
                                $.each(data, function (i, oBE) {
                                    var oOption = '<option value="' + oBE.Codigo + '">' + oBE.Descripcion + '</option>';
                                    $("#selDependencia").append(oOption);
                                });
                              //  $("#btnLogin").focus();
                            }
                        },
                        error: function (xhr, status, err) {

                            console.log(err);

                        }
                    });
            });
        });

       

        function mueveFoco(obj, goTo) {
            var to;
            if (obj.type != 'textarea') {
                if (goTo) {
                    to = document.getElementById(goTo);
                }
                else {
                    var ltabindex = obj.tabIndex + 1;
                    to = jQuery("*[tabindex=" + ltabindex + "]")[0];
                }
                if (to != null && typeof (obj) != 'undefined') {
                    jQuery(obj).removeClass('activado_confoco').addClass('normal');
                    jQuery(to).removeClass('normal').addClass('activado_confoco');
                    try {
                        to.focus();
                        to.select();
                    } catch (e) {
                    }
                }
            }
        }

    </script>

</head>

<body class="app flex-row align-items-center">

    <!-- Modal -->
    @*INICIO*@

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card-group ">
                    <div class="card p-4">
                        <div class="card-body text-danger">
                            <h3>Consulta por expediente   </h3>
                            <p class="text-muted">Ingrese sus credenciales del S.I</p>


                            <div class="input-group mb-2">
                                <div class="input-group-prepend">
                                    <span class="input-group-text">
                                        <i class="icon-user"></i>
                                    </span>
                                </div>
                                <input id="txtUsuario" class="form-control" type="text" placeholder="Usuario" />
                            </div>

                            <div class="input-group mb-2">
                                <div class="input-group-prepend">
                                    <span class="input-group-text">
                                        <i class="icon-list"></i>
                                    </span>
                                </div>
                                <input id="txtPassword" class="form-control" type="password" placeholder="Contraseña" />
                            </div>

                            <div class="row">

                                <div class="col-6" style="height:10px;margin-top:20px;">
                                    <button id="btnLogin" class="btn bg-danger px-4" type="button">    Ingresar    </button>
                                </div>
                            </div>



                        </div>
                    </div>


                    <div class="card p-4 text-white bg-light py-5 d-md-down-none" style="width:44%">
                        <div class="card align-text-top ">
                            <img height="180" src="~/Content/images/brands/sgdIrtp2.png" />
                            @*<img height="200" width="100%" src="~/Content/images/brands/sgdIrtp2.png" />*@
                        </div>
                        <div class="bg-light text-center text-danger">
                            <p>Bienvenido al aplicativo de consultas por expedientes</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @*FIN*@

    <div style="display:none;position:absolute;z-index:100000;top:0px;left:0px;width:100%;height:100%
                  ;background-image:url(../../Content/images/brands/cargando2.gif);background-repeat:no-repeat;background-position:center" id="cargando">

    </div>

    <div>
        <input type="hidden" id="hdfOculto" value="@Url.Content("~")" />
        <input type="hidden" id="iidtipousugeneral" value="@Session["iidtipousu"]" />

        <div id="divLoading" style="display:none;background-image:url(../../Content/images/brands/cargando2.gif);position:absolute;top:0;left:0;
                           width:100%;height:100%;
                           background-repeat:no-repeat;background-position:center;z-index:2000  ">

        </div>
    </div>


</body>

</html>
