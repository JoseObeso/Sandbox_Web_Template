<input type="hidden" value="@Url.Content("~")" id="hdfOculto" />
<script type="text/javascript">

    var barChart = null;
    var chartColors = {
        red: 'rgb(255, 99, 132)',
        orange: 'rgb(255, 159, 64)',
        yellow: 'rgb(255, 205, 86)',
        green: 'rgb(75, 192, 192)',
        blue: 'rgb(54, 162, 235)',
        purple: 'rgb(153, 102, 255)',
        grey: 'rgb(201, 203, 207)'
    };
    var colorNames = Object.keys(chartColors);
    var color = Chart.helpers.color;

    function requestServer(tipoMetodo, url, metodoCallBack, texto) {
        var xhr = new XMLHttpRequest();
        xhr.open(tipoMetodo, url);
        xhr.onreadystatechange = function () {
            if (xhr.status == 200 && xhr.readyState == 4) {
                metodoCallBack(xhr.responseText);
            }
        }
        if (tipoMetodo == "get") xhr.send();
        else {
            if (texto != "") xhr.send(texto);
        }
    }
    var post = function (url, metodoCallBack, texto) {
        requestServer("post", url, metodoCallBack, texto);
    }

    var lstMonths = ['Ene.', 'Feb.', 'Mar.', 'Abr.', 'May.', 'Jun.', 'Jul.',
        'Ago.', 'Sep.', 'Oct.', 'Nov.', 'Dic.'];

    var url_doc_recibidos = 'http://' + document.domain + ':8091/Reportes/';



    function fetchGetArchivo(url, callback, mensaje = "Se descargo el archivo Excel") {
        var raiz = document.getElementById("hdfOculto").value;
        var urlAbsoluta = window.location.protocol + "//" + window.location.host + raiz + url;
        fetch(urlAbsoluta).then(res => res.text())
            .then(res => {
                if (res.length > 1) {
                    callback(res)
                }
                else
                    callback("")
            })
    }

    function fetchGetJSON(url, callback, mensaje = "Se descargo el archivo Excel") {
        var raiz = document.getElementById("hdfOculto").value;
        var urlAbsoluta = window.location.protocol + "//" + window.location.host + raiz + url;
        fetch(urlAbsoluta).then(res => res.json())
            .then(res => {
                callback(res)
            })
    }

    //Descarga documentos del SGD en PDF
    function DescargarDoc(id, nom) {
        fetchGetArchivo("Reportes/ExportarPDF/?iiddoc=" + id, function (rpta) {
            var a = document.createElement("a");
            var link = "data:application/pdf;base64," + rpta;

            a.href = link;
            a.download = nom + ".pdf";

            a.click();
        })
    }

    //Visualiza lista de anexos
    var iid;
    function AnexoDoc(id) {
        iid = id;
        fetchGetJSON("Reportes/listaAnexos/?numEmision=" + id, function (rpta) {
            var tbodyData = document.getElementById("tbodydata");
            var contenido = "";
            if (rpta.length <= 1) {
                for (var i = 0; i < rpta.length; i++) {
                    contenido += "<tr>";
                    contenido += `<td onclick="Exportar('${rpta[i].NroDocumento}',${rpta[i].Anio})">`;
                    contenido += rpta[i].NroDocumento
                    contenido += "</td>";
                    contenido += "</tr>";
                }
                tbodyData.innerHTML = contenido;
            }

        })
    }

    //Visualiza documento del anexo
    function Exportar(nro, id) {
        fetchGetArchivo("Reportes/recuperarPDFAnexos/?iiddoc=" + iid + "&correlativo=" + id, function (base) {
            if (nro.toUpperCase().includes(".PDF")) {
                var a = document.createElement("a");
                a.href = "data:application/pdf;base64," + base;
                a.download = id + ".pdf";
                a.click()
            }
            else
                if (nro.toUpperCase().includes(".DOC")) {
                    var a = document.createElement("a");
                    a.href = "data:application/msword;base64," + base; a.download = id + ".doc"; a.click()
                }
                else
                    if (nro.toUpperCase().includes(".XLS")) {
                        var a = document.createElement("a");
                        a.href = "data:application/vnd.ms-excel;base64," + base; a.download = id + ".xls"; a.click()
                    }
                    else
                        if (nro.toUpperCase().includes(".JPG")) {
                            var a = document.createElement("a");
                            a.href = "data:image/jpeg;base64," + base; a.download = id + ".jpg"; a.click()
                        }
                        else { alert("Se descarga solo documentos en .PDF .DOC .XLS y .JPG"); }
        })
    }




    function ver_coddependencia_documentos() {
        var lc_codsesion = $("#ccoddependencia").val();
        var valor = $("#cbxDependencia option:selected").attr('value');
        if (valor == "") {
            var v_coddependencia = lc_codsesion;
        }
        else {
            var v_coddependencia = $("#cbxDependencia option:selected").attr('value');
        }

        $.ajax({
            type: 'POST',
            url: '../Reportes/_DocumentosPorDependencia',
            data: { 'coddependencia': v_coddependencia },
            dataType: 'json',
            success: function (data) {
                $("#TipoDocumentoDependencia")
                    .html("")
                    .append('<option id="">Seleccionar...</option>');

                data.forEach(function (filas) {
                    for (var e = 0; e < filas.length; e++) {
                        $("#TipoDocumentoDependencia")
                            .attr("disabled", false)
                            .append('<option id="' + filas[e].Vco_tip_doc
                                + '"  >' + filas[e].Vcdoc_desdoc + '</option>');
                    }
                });
            },
            error: function (xhr, status, err) {
                console.log(err);
            }
        });
    }

    $(document).ready(function () {
        ver_coddependencia_documentos();
        $("#cbxDependencia").on('change', function () {
            ver_coddependencia_documentos();
        });

        $("#btnConsultar").click(function () {
