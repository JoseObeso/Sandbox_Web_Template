            $.each(lstDocumentos, function (x, strdocumento) {
                total = 0;
                $.each(dataList, function (i, oItem) {
                    if (oItem.DescTipoDocumento == strdocumento)
                        total = total + oItem.Total;
                });

                var htmlElemento = '<li  class="list-group-item d-flex justify-content-between align-items-left" >' + strdocumento +
                    '<span class="badge ">' + total + '</span>' + '</li >';
                    sumatotalDoc += total

                $('#ulResumenData').append(htmlElemento);
            });


            if (sumatotalDoc == 0) {
                htmlElemento = "";
            }
            else {
                var htmlElemento = '<li  class="list-group-item d-flex justify-content-between align-items-left">' + "TOTAL DE DOCUMENTOS:" +
                    '<span class="badge badge-danger">' + sumatotalDoc + '</span>' + '</li >';
                $('#ulResumenData').append(htmlElemento);
            }
        }
        */
