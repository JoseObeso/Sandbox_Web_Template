                    Anio: $("#cbxAnio option:selected").val(),
                },
                contentType: 'application/json;charset=utf-8',
                dataType: "json",
                success: function (data) {
                    CargarGrafico(data);
                    var tbodyData = document.getElementById("tbodydata");
                    tbodyData.innerHTML = "";

                },
                error: function (e) {
                    //alert(e.statusText);
                }
            });
            ver_listar_documentos();

        });


        function ver_listar_documentos() {
            var v_coddependencia = $("#cbxDependencia option:selected").attr('value');
            var v_asunto = $('#txtBusqueda').val();

            $.ajax({
                type: 'GET',
                url: '_GridEmitidosView',
                data: {
                    CodDependencia: v_coddependencia,
                    Asunto: v_asunto,
                    CodTipoDocumento: $("#TipoDocumentoDependencia option:selected").attr('id'),
                    Mes: $("#cbxMeses option:selected").attr('value'),
                    Anio: $("#cbxAnio option:selected").val(),
                },
                contentType: 'application/json;charset=utf-8',
                dataType: "json",
                success: function (data) {
                    $('#divGridContainer').html(data);
                },
                error: function (e) {
                    $('#divGridContainer').html(e.responseText);
                    // alert(e.statusText);
                }
            });
        }


        /* Total por tipo de documentos segùn año*/
        function CargarGrafico(dataList) {

            $("#divBarrasChart").html('&nbsp;');
            $("#divBarrasChart").append('<canvas id="canvas1"></canvas>');

            var lstDocumentos = [];
            var lstDatos = [];
            var totalData = [];

            $.each(dataList, function (i, item) {
                if (jQuery.inArray(item.DescTipoDocumento, lstDocumentos) == -1)
                    lstDocumentos.push(item.DescTipoDocumento);
            });

            var colorI = 1;
            $.each(lstDocumentos, function (index, itemDoc) {
                lstDatos = [];
                for (iMes = 1; iMes <= 12; iMes++)
                    $.each(dataList, function (j, oItem) {
                        if (oItem.Mes == iMes && oItem.DescTipoDocumento == itemDoc)
                            lstDatos.push(oItem.Total);
                    });

                if (lstDatos.length > 0) {

                    var colorBG = colorNames[colorI % colorNames.length];
                    var dsColor = chartColors[colorBG];
                    var dataset = {
                        label: itemDoc,
                        backgroundColor: color(dsColor).alpha(0.5).rgbString(),
                        borderColor: dsColor,
                        //highlightFill: 'rgba(220, 220, 220, 0.75)',
                        //highlightStroke: 'rgba(220, 220, 220, 1)',
                        fill: false,
                        data: lstDatos,
                        borderWidth: 1
                    };
                    colorI = colorI + 1;
                    totalData.push(dataset);
                }
            });


            barChart = new Chart($('#canvas1'), {
                type: 'bar',
                data: {
                    labels: lstMonths,
                    datasets: totalData
                },
                options: {
                    responsive: true,
                    scales: {
                        xAxes: [{
                            display: true,
                            gridLines: {
                                drawOnChartArea: false,
                            },
                            ticks: {
                                maxRotation: 360,
                                minRotation: 0
                            }
                        }],
                        yAxes: [{
                            display: true,
                            gridLines: {
                                drawOnChartArea: false,
                                backgroundColor: '#f5bfc0'
                            },
                            ticks: {
                                beginAtZero: true
                            }
                        }]
                    }
                }
            });
            //ResumenDatos(dataList, lstDocumentos);

        }
