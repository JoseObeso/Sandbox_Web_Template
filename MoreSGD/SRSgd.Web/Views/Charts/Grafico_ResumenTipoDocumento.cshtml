        /* Total por tipo de documentos segùn año*/
        function CargarGrafico(dataList) {


            $("#divBarrasChart").html('&nbsp;');
            $("#divPastelChart").html('&nbsp;');

            $("#divBarrasChart").append('<canvas id="canvas1"></canvas>');
            $("#divPastelChart").append('<canvas id="canvas2"></canvas>');

            var lstEtiquetas = [];
            var lstDatos = [];

            $.each(dataList, function (i, item) {
                lstEtiquetas.push(item.DescTipoDocumento);
                lstDatos.push(item.Total);

            });

            //console.log(lstEtiquetas, lstDatos);
            console.log(lstEtiquetas, lstDatos, lstBGColores);

            barChart = new Chart($('#canvas1'), {
                type: 'bar',
                data: {
                    labels: lstEtiquetas,
                    datasets: [{
                        label: 'Cant. Documentos',
                        // backgroundColor: 'rgba(220, 220, 220, 0.5)',

                        backgroundColor: 'rgba(128, 128, 128, 0.5)',

                        //   borderColor: 'rgba(220, 220, 220, 0.8)',
                        //    highlightFill: 'rgba(220, 220, 220, 0.75)',
                        //   highlightStroke: 'rgba(220, 220, 220, 1)',

                        data: lstDatos,
                        borderWidth: 1
                    }
                    ]
                },
                options: {
                    responsive: true,
                    scales: {
                        xAxes: [{
                            ticks: {
                                maxRotation: 90,
                                minRotation: 80
                            }
                        }],
                        yAxes: [{
                            ticks: {
                                beginAtZero: true
                            }
                        }]
                    }
                }
            });

            var lstBGColores = ["#8e5ea2", "#525b5c", "#3cba9f", "#3e95cd", "#c45850", "#a3d5d3", "#3e9500",
                "#f78383", "#549aab", "#3cba00", "#47c89b", "#c458ff", "#ffc100", "#cccc00"];

            new Chart($("#canvas2"), {
                type: 'pie',
                data: {
                    labels: lstEtiquetas,
                    datasets: [{
                        label: "Documentos(Unidades)",
                        backgroundColor: lstBGColores,
                        data: lstDatos
                    }]
                },
                options: {
                    title: {
                        display: true,
                        text: 'Emisiones realizadas'
                    }
                }
            });

        }





