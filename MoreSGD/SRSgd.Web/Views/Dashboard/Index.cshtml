                        backgroundColor: '#60c95d', 
                        borderWidth: 3,
                        pointBorderColor: 'black',
                        pointBackgroundColor: 'black',
                        

                        data: yValues
                    }]
                },
                options: {
                    maintainAspectRatio: false,
                    legend: {
                        display: false
                    },
                    pointRadius: 5,
                    scales: {
                        xAxes: [{
                            display: true, //false,
                            gridLines: {
                                drawOnChartArea: false
                            },
                            ticks: {
                                fontColor: "#235922",
                                fontSize: 10,
                                maxTicksLimit: 5
                            }
                        }],
                        yAxes: [{
                            display: false,
                            ticks: {
                                beginAtZero: true,
                                maxTicksLimit: 5
                                // fontColor: hexToRgba(getStyle('--info'), 10)
                            }
                        }]
                    },
                    elements: {
                        point: {
                            radius: 0,
                            hitRadius: 10,
                            hoverRadius: 4,
                            hoverBorderWidth: 3
                        }
                    }
                }
            });
        }

        ///////////////////////////////////////////////////////

    });
</script>


