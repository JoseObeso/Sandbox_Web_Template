    //Para despacho

        function documentos_paradespacho() {
            $.ajax({
                type: 'GET',
                url: '@Url.Action("_DocumentosDespacho", "Dashboard")',
                contentType: 'application/json;charset=utf-8',
                dataType: "json",
                success: function (data) {
                    var xValuesMes = [];
                    var yValuesTotal = [];
                    for (let index = 0; index < data.length; index++) {
                        xValuesMes.push(data[index].V_mes);
                        yValuesTotal.push(data[index].I_total);
                    }
                    crear_graficoBarra4(xValuesMes, yValuesTotal, "line", "Documentos Para Despacho");
                },
                error: function (e) {
                    alert(e.statusText);
                }
            });
        }

        

         function documentos_paradespacho_total() {

             $.ajax({
                type: 'GET',
                url: '@Url.Action("_Documentosparadespacho_total", "Dashboard")',
                contentType: 'application/json;charset=utf-8',
                dataType: "json",
                 success: function (data) {
                     var ln_i_total = data.length;
                     if (ln_i_total == 0) {
                         $("#total_paradespacho").text("0");
                     }
                     else {
                         $("#total_paradespacho").text(data[0].I_total);

                     }
                },
                error: function (e) {
                    alert(e.statusText);
                }
            });


        }



