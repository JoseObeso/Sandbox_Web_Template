    <link href="~/lib/coreui/node_modules/flag-icon-css/css/flag-icon.min.css" rel="stylesheet" />
    <link href="~/lib/coreui/node_modules/font-awesome/css/font-awesome.min.css" rel="stylesheet" />
    <link href="~/lib/coreui/node_modules/simple-line-icons/css/simple-line-icons.css" rel="stylesheet" />

    <link href="~/lib/coreui/css/style.css" rel="stylesheet" />
    <link href="~/lib/coreui/vendors/pace-progress/css/pace.min.css" rel="stylesheet" />
    <script async="" src="https://www.googletagmanager.com/gtag/js?id=UA-118965717-3"></script>

    <script src="~/lib/coreui/node_modules/jquery/dist/jquery.min.js"></script>
    <script type="module" src="~/lib/coreui/node_modules/popper.js/dist/popper.min.js"></script>
    <script src="~/lib/coreui/node_modules/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="~/lib/coreui/node_modules/pace-progress/pace.min.js"></script>
    <script src="~/lib/coreui/node_modules/perfect-scrollbar/dist/perfect-scrollbar.min.js"></script>
    <script src="~/@("lib/coreui/node_modules/@coreui/coreui/dist/js/coreui.min.js")"></script>
    <script src="~/Scripts/sweetalert.js"></script>
    <script type="text/javascript">
        window.dataLayer = window.dataLayer || [];

        function gtag() {
            dataLayer.push(arguments);
        }
        gtag('js', new Date());
        gtag('config', 'UA-118965717-3');
        gtag('config', 'UA-118965717-5');


        $(document).ready(function () {


            $("#btnLogin").click(function () {

                if ($("#txtUsuario").val() /*&& $("#txtPassword").val()*/ && $("#selDependencia option:selected").val()) {

                    document.getElementById("cargando").style.display = "block";
                    $.ajax({
                        type: 'POST',
                        url: '@Url.Action("Login", "Login")',
                        data: {
                            pUsuario: $("#txtUsuario").val(),
                            pPassword: $("#txtPassword").val(),
                            pCodDependencia: $("#selDependencia option:selected").val(),
                            pDependencia: $("#selDependencia option:selected").text()
                        },
                        //contentType: 'application/html',
                        dataType: 'json',
                        success: function (response) {
                            if (response.Url == "El Usuario o la Contraseña es incorrecta") {
                                Swal.fire({
                                    icon: 'Error',
                                    title: 'Error Login',
                                    text: response.Url
                                })
                            } else {
                                Swal.fire({
                                    position: 'top-end',
                                    icon: 'success',
                                    title: 'Bienvenido al Sistema ',
                                    showConfirmButton: false,
                                    timer: 1500
                                })
                                window.location.href = response.Url;

                            }
                            document.getElementById("cargando").style.display = "none";

                        },
                        error: function (xhr, status, err) {

                            //console.log("XHR: ", xhr.responseText);
                            //var err = eval("(" + xhr.responseText + ")");
                            alert(err + " - " + status);
                            jsonValue = jQuery.parseJSON(xhr.responseText);
                            console.log(jsonValue.Message);
                            document.getElementById("cargando").style.display = "none";


                        }
                    });

                }
                else {

                    alert("Debe completar todos los campos!..");
                }

            });


            $("#txtUsuario").on("keypress keydown", function (e) {

                //var inKey = e.keyCode || e.which;
                console.log(e.keyCode);

                if (e.keyCode == 13 || e.keyCode == 9) {

                    $.ajax({
                        type: 'GET',
                        url: '@Url.Action("FiltroDependencia", "Login")',
                        data: {
                            pUsuario: $(this).val(),
                            pCodEmp: ''
                        },
                        dataType: 'json',
                        success: function (data) {
                           //  console.log(data);
                            $("#selDependencia").empty();//html('$nbsp;');
                            if (data != null) {

                                $.each(data, function (i, oBE) {
                                    var oOption = '<option value="' + oBE.Codigo + '">' + oBE.Descripcion + '</option>';

                                    $("#selDependencia").append(oOption);
                                });
                            }
                        },
                        error: function (xhr, status, err) {

                            console.log(err);

                        }
                    });


                    //else {
                    //    inputs[idx + 1].focus(); //  handles submit buttons
                    //    inputs[idx + 1].select();
                    //}
                    return true;
                }

            });


        });

        var KeyboardClass = function (pEv, pOkeys) { this.anykeys = ((typeof (pOkeys) == 'string') && (pOkeys.length > 0)) ? pOkeys : ' ./|-()*"0123456789abcdefghijklmnñopqrstuvwxyzABCDEFGHIJKLMNÑOPQRSTUVWXYZ'; this.espKeysList = (typeof (public_esp_keys) != 'undefined') ? public_esp_keys : [8, 13, 27, 37, 39, 46]; this.objEvent = (window.event) ? window.event : pEv; this.currentObj = this.objEvent.target || this.objEvent.srcElement; this.k = this.objEvent.keyCode || this.objEvent.which; this.character = String.fromCharCode(this.k); this.isSpecialKey = function () { for (var i in this.espKeysList) { if (this.k == this.espKeysList[i]) { return true } } return false }; this.isIntro = function () { if ((this.k == 13) || (this.k == 9) || (this.k == 0)) { return true } return false }; this.isHelp = function () { if (this.k == 113) { return true } return false }; this.isValidKey = this.anykeys.indexOf(this.character) != -1 || this.isSpecialKey() }

        function filtroUserDepen(pEvent, autoSubmit, pvalidKeys, sucessGoToId, errorGoToId, callbackFunction) {

            var tk = new KeyboardClass(pEvent, pvalidKeys);
            if (tk.isIntro()) {
                if (callbackFunction) {
                    (callbackFunction(tk.objEvent, tk.currentObj)) ? mueveFoco(tk.currentObj, sucessGoToId) : mueveFoco(tk.currentObj, errorGoToId);
                }
                else {
                    mueveFoco(tk.currentObj, sucessGoToId);
                }
            }
            return (((autoSubmit) ? autoSubmit : false) == true) ? tk.isValidKey : (tk.isValidKey && tk.k != 13);

        }

        function Guardar() {
            var contra = document.getElementById("txtcontra").value;
            var contra2 = document.getElementById("txtcontra2").value;
            if (contra == "") {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Debe ingresar su contraseña'
                })
                return;
            }
            if (contra2 == "") {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Debe repetir su contraseña'
                })
                return;
            }
            if (contra.length < 4) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'La contraseña debe tener minimo 4 caracteres'
                })
                return;
            }
            if (contra2.length < 4) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'La repeticion de la contraseña debe tener minimo 4 caracteres'
                })
                return;
            }
            if (contra != contra2) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Las contraseñas no coinciden'
                })
                return;
            }

            Swal.fire({
                title: 'Desea guardar su contraseña?',
                text: "Desea guardar su contraseña?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Si',
                cancelButtonText: 'No'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire(
                        'Deleted!',
                        'Your file has been deleted.',
                        'success'
                    )
                }
            })
        }

        function mueveFoco(obj, goTo) {
            var to;
            if (obj.type != 'textarea') {
                if (goTo) {
                    to = document.getElementById(goTo);
                }
                else {
                    var ltabindex = obj.tabIndex + 1;
                    to = jQuery("*[tabindex=" + ltabindex + "]")[0];
                }
                if (to != null && typeof (obj) != 'undefined') {
                    jQuery(obj).removeClass('activado_confoco').addClass('normal');
                    jQuery(to).removeClass('normal').addClass('activado_confoco');
                    try {
                        to.focus();
                        to.select();
                    } catch (e) {
                    }
                }
            }
        }

    </script>

</head>

<body class="app flex-row align-items-center">

    <!-- Modal -->
    <div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Registrar Contraseña</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div>
                        <label>Contraseña</label>
                        <input type="password" id="txtcontra" class="form-control" />
                    </div>
                    <div>
                        <label>Confirmar Contraseña</label>
                        <input type="password" id="txtcontra2" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" onclick="Guardar()">Guardar</button>
                </div>
            </div>
        </div>
    </div>


    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card-group">
                    <div class="card p-4">
                        <div class="card-body">
                            <h1>SGD REPORTING</h1>
                            <p class="text-muted">Ingrese sus credenciales</p>
                            <div class="input-group mb-3">
                                <div class="input-group-prepend">
                                    <span class="input-group-text">
                                        <i class="icon-user"></i>
                                    </span>
                                </div>
                                <input id="txtUsuario" class="form-control" type="text" placeholder="Usuario" />
                            </div>

                            <div class="input-group mb-3">
                                <div class="input-group-prepend">
                                    <span class="input-group-text">
                                        <i class="icon-list"></i>
                                    </span>
                                </div>
                                <input id="txtPassword" class="form-control" type="password" placeholder="Contraseña" />
                            </div>

                            @*<div class="input-group mb-4">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text">
                                            <i class="icon-lock"></i>
                                        </span>
                                    </div>
                                    <input id="txtPassword" class="form-control" type="password" placeholder="Contraseña" />
                                </div>*@

                            <div class="input-group mb-4">
                                <div class="input-group-prepend">
                                    <span class="input-group-text">
                                        <i class="icon-list"></i>
                                    </span>
                                </div>
                                <select id="selDependencia" class="form-control" title="Dependencia"></select>
                            </div>
                            <div class="row">
                                <div class="col-6">
                                    <button id="btnLogin" class="btn btn-primary px-4" type="button">Login</button>
                                    @*<button type="button" class="btn btn-primary btn-inline" data-toggle="modal" data-target="#exampleModal">
                                            Launch demo modal
                                        </button>*@
                                </div>
                                <div class="col-6 text-right">
                                    @*<button class="btn btn-link px-0" type="button">Cambiar contraseña?</button>*@
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card text-white bg-primary py-5 d-md-down-none" style="width:44%">
                        <div class="card-body align-text-top ">
                            <img height="200" width="100%" src="~/Content/images/brands/sgdIrtp2.png" />
                            <div class="text-center">
                                <p>Aplicación web en la que dispondrá de Reportes e Informes consolidados de toda la actividad realizada en el sistema de gestión documental SGD.</p>
                                @*<button class="btn btn-primary active mt-3" type="button">Refrescar</button>*@
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div style="display:none;position:absolute;z-index:100000;top:0px;left:0px;width:100%;height:100%
      ;background-image:url(../../Content/images/brands/cargando2.gif);background-repeat:no-repeat;background-position:center" id="cargando">

    </div>



</body>

</html>
