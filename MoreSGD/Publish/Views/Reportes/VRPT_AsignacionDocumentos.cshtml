@using SRSgd.Web.Models.Reporting
@model RepoRecibidosModel

    @{
        ViewBag.Title = "VRPT_AsignacionDocumentos";
        Layout = "~/Views/Shared/_Layout.cshtml";
    }

    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.10.20/css/jquery.dataTables.css">
    <script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.10.20/js/jquery.dataTables.js"></script>

    <script>

    $(document).ready(function () {

        var rightNow = new Date();
        var res = rightNow.toISOString().slice(0, 10)

        $('#dpFechaInicio').val(res);
        $('#dpFechaFin').val(res);


        $("#btnConsultar").click(function () {
                        
            $.ajax({
                type: 'GET',
                url: '_GridAsignacionesView',
                data: {
                    CodDependencia: $("#cbxDependencia option:selected").val(),
                    CodTipoDocumento: $("#cbxTipoDocumento option:selected").val(),
                    FechaInicio: $("#dpFechaInicio").val(),
                    FechaFin: $("#dpFechaFin").val(),
                    CodEstado: $("#cbxEstadoRec").val(),//EstadoRecepcion
                    CodEmpleadoAsignado: $("#cbxEmpleadoAsignado option:selected").val(),
                    TextoFiltro: $("#txtBusqueda").val()
                },
                contentType: 'application/html',
                //data: JSON.stringify(model),
                dataType: "html",
                success: function (content) {
                    $('#divGridContainer').html(content);
                },
                error: function (e) {
                    alert(e.statusText);
                }
            });

        });


        $("#cbxDependencia").change(function () {

            
                //if (e.keyCode == 13 || e.keyCode == 9) {

                    $.ajax({
                        type: 'GET',
                        url: '@Url.Action("ListarEmpleadosDependencia", "General")',
                        data: {
                            CodDependencia: $(this).val()                            
                        },
                        dataType: 'json',
                        success: function (data) {
                            console.log(data);
                            $("#cbxEmpleadoAsignado").empty();//html('$nbsp;');
                            $("#cbxEmpleadoAsignado").append('<option value="">..Seleccionar..</option>');

                            if (data != null) {
                                                                
                                $.each(data, function (i, oBE) {
                                    var oOption = '<option value="' + oBE.CodEmpleado + '">' + oBE.NombreCompleto + '</option>';

                                    $("#cbxEmpleadoAsignado").append(oOption);
                                });
                            }
                        },
                        error: function (xhr, status, err) {

                            console.log(err);

                        }
                    });

                    return true;
                //}

        });



    });

    </script>


    <div class="container-fluid">
        <div class="col-md-12">

            <div class="card">
                <div class="card-header">
                    <strong>ASIGNACION DE DOCUMENTOS</strong>
                </div>
                <div class="card-body">

                    <div class="form-horizontal" role="form">
                        <div class="row">
                            <div class="form-group col-sm-3">
                                <label class="control-label" for="date-input">Dependencia <span class="text-danger" title="Filtro obligatorio">*</span></label>
                                <div class="">
                                    @Html.DropDownListFor(x => x._Filtros.CodDependencia, Model.LstDependencias.Select(item => new SelectListItem { Value = item.Codigo, Text = item.Descripcion }),
                                                                htmlAttributes: new { @class = "form-control form-control-md", @id = "cbxDependencia" })
                                </div>
                            </div>
                            <div class="form-group col-sm-3">
                                <label class="control-label" for="date-input">Tipo Documento</label>

                                @Html.DropDownListFor(x=>x._Filtros.CodTipoDocumento, Model.LstTipoDocumentos.Select(item => new SelectListItem { Value = item.CodigoTipoDoc, Text = item.Descripcion }),
                                                            "..Seleccionar..", new { @class = "form-control form-control-md", @id = "cbxTipoDocumento" })

                            </div>
                            <div class="form-group col-sm-2">
                                <label class="control-label">Estado Recepción</label>
                                @Html.DropDownListFor(x=>x._Filtros.CodEstado, Model.LstEstadosTran.Select(item => new SelectListItem { Value = item.CodigoEstado, Text = item.Descripcion }),
                                                            "..Seleccionar..", new { @class = "form-control form-control-md", @id = "cbxEstadoRec" })
                            </div>
                            <div class="form-group col-sm-4">
                                <label class="control-label">Asignado a</label>
                                @Html.DropDownListFor(x=>x._Filtros.CodEmpleadoAsignado, Model.LstEmpleadosDestino.Select(item => new SelectListItem { Value = item.CodEmpleado, Text = item.NombreCompleto }),
                                                            "..Seleccionar..", new { @class = "form-control form-control-md", @id = "cbxEmpleadoAsignado" })
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-3">
                                <div class="form-group">
                                    <label class="control-label" for="date-input">Desde <span class="text-danger" title="Filtro obligatorio">*</span></label>
                                    <div class="">
                                        <input id="dpFechaInicio" class="form-control" type="date" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-3">
                                <div class="form-group">
                                    <label class="control-label" for="date-input">Hasta <span class="text-danger" title="Filtro obligatorio">*</span></label>
                                    <div class="">
                                        <input id="dpFechaFin" class="form-control" type="date" />
                                    </div>
                                </div>
                            </div>
                            <div class="form-group col-sm-6">
                                <label class="control-label">Expediente / Documento / Asunto </label>
                                <input id="txtBusqueda" type="text" class="form-control" placeholder="Ingresar" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <input type="button" id="btnConsultar" class="btn btn-primary" value="Consultar" />
                    </div>
                </div>
            </div>

            <div class="card">

                <div id="divGridContainer">
                </div>


            </div>
        </div>
    </div>