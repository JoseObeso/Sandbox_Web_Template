@using System.Data
@model System.Data.DataTable

<script type="text/javascript">

    $(document).ready(function () {

        $("#cbxDependencia").attr("disabled", true);

        $('#mainTable').DataTable();
    });

</script>

<table id="mainTable" class="table table-responsive-sm table-striped">
    <thead>
        <tr>
            <th>Documento</th>
            <th>Expediente</th>
            <th>Remitente</th>
            <th>F.Emisión</th>
            <th>Asunto</th>
            <th>Estado</th>
        </tr>
    </thead>
    <tbody>

        @if (Model != null)
        {
            foreach (DataRow row in Model.Rows)
            {
                <tr>
                    <td>@row["Documento"]</td>
                    <td>@row["NroExpediente"]</td>
                    <td>@row["EmpleadoRemitente"]</td>
                    <td>@row["FechaEmision"]</td>
                    <td>@row["Asunto"]</td>
                    <td>@row["EstadoDocumento"]</td>
                </tr>
            }
        }
    </tbody>
</table>