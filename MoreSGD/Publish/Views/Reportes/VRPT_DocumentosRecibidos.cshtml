<script>

    function fecha_actual() {
        var f6 = new Date(),
            gn6_mes = (f6.setMonth(f6.getMonth() + 0)) + 1;
        var fn6 = (f6.getMonth() + 1);
        var fecha_real_time = (f6.getFullYear() + "-" + (('' + fn6).length < 2 ? '0' : '') + fn6 + "-" + f6.getDate());
        return fecha_real_time;

    }

    function dia_mes_anio_real_time_6_meses_antes() {
        var f6 = new Date(),
            gn6_mes = (f6.setMonth(f6.getMonth() + -1)) + 1;
        var fn6 = (f6.getMonth() + 1);
        var fecha_6_meses_antes = (f6.getFullYear() + "-" + (('' + fn6).length < 2 ? '0' : '') + fn6 + "-" + f6.getDate());
        return fecha_6_meses_antes;

    }

    var url_doc_recibidos = 'http://' + document.domain + ':8091/Reportes/';
    //var url_doc_recibidos = 'http://' + document.domain + ':2135/Reportes/';


    function ver_coddependencia_documentos() {
        var v_coddependencia = $("#cbxDependenciaOrigen option:selected").attr('value');
        $.ajax({
            type: 'POST',
            url: url_doc_recibidos + '_DocumentosPorDependencia',
            data: { 'coddependencia': v_coddependencia },
            dataType: 'json',
            success: function (data) {
                $("#TipoDocumentoDependencia")
                    .html("")
                    .append('<option id=""> Seleccione ... </option>');

                data.forEach(function (filas) {
                    for (var e = 0; e < filas.length; e++) {
                        $("#TipoDocumentoDependencia")
                            .attr("disabled", false)
                            .append('<option id="' + filas[e].Vco_tip_doc
                                + '"  >' + filas[e].Vcdoc_desdoc + '</option>');
                    }
                });
            },
            error: function (xhr, status, err) {
                console.log(err);
            }
        });
    }


    function mostrar_registros_6_meses(fecha1, fecha2) {
        var V_dependencia = $("#cbxDependencia option:selected").attr('value'),
            V_dependenciaOrigen = $("#cbxDependenciaOrigen option:selected").attr('value'),
            V_tipodocumento = $("#TipoDocumentoDependencia option:selected").attr('id'),
            V_estado = $("#cbxEstado option:selected").attr('value'),
            V_fechainicio = fecha1,
            V_fechafin = fecha2,
            V_asunto = $('#txtBusqueda').val(),
            datos_recibidos = {
                "CodDependencia": V_dependencia,
                "CodDependenciaOrigen": V_dependenciaOrigen,
                'CodTipoDocumento': V_tipodocumento,
                'CodEstado': V_estado,
                "Inicio": V_fechainicio,
                "Fin": V_fechafin,
                "Asunto": V_asunto
            };
        $.ajax({
            type: 'GET',
            url: '_GridRecibidosView',
            data: datos_recibidos,
            contentType: 'application/html',
            dataType: "html",
            success: function (content) {

                $('#divGridContainer').html(content);

            },
            error: function (e) {
                alert(e.statusText);
            }
        });



    }

    function fetchGetArchivo(url, callback, mensaje = "Se descargo el archivo Excel") {
        var raiz = document.getElementById("hdfOculto").value;
        var urlAbsoluta = window.location.protocol + "//" + window.location.host + raiz + url;
        fetch(urlAbsoluta).then(res => res.text())
            .then(res => {
                if (res.length > 1) {
                    callback(res)
                }
                else
                    callback("")

            })

    }


    function Descargar(id, nom) {

        fetchGetArchivo("Reportes/ExportarPDF/?iiddoc=" + id, function (rpta) {
            var a = document.createElement("a");
            var link = "data:application/pdf;base64," + rpta;
            a.href = link;
            a.download = nom + ".pdf";
            a.click();

        })
    }



    $(document).ready(function () {
        $('#dpFechaInicio').val(dia_mes_anio_real_time_6_meses_antes());
        $('#dpFechaFin').val(fecha_actual());

        var lc_cod_sesion = $("#CodDependencia").val();

        if (lc_cod_sesion == 'AADMIN') {
            $("#cbxDependencia").attr("disabled", false);
        } else {
            $("#cbxDependencia").attr("disabled", true);
        }

        ver_coddependencia_documentos();

        $("#cbxDependenciaOrigen").on('change', function () {
            ver_coddependencia_documentos();
        });

        $('#btnLimpiar').click(function () {
            window.location.href = window.location.href;
        });

        mostrar_registros_6_meses(dia_mes_anio_real_time_6_meses_antes(), fecha_actual());

        $("#btnConsultar").click(function () {
            var V_dependencia = $("#cbxDependencia option:selected").attr('value'),
                V_dependenciaOrigen = $("#cbxDependenciaOrigen option:selected").attr('value'),
                V_tipodocumento = $("#TipoDocumentoDependencia option:selected").attr('id'),
                V_estado = $("#cbxEstado option:selected").attr('value'),
                V_fechainicio = $('#dpFechaInicio').val(),
                V_fechafin = $('#dpFechaFin').val(),
                V_asunto = $('#txtBusqueda').val(),
                datos_recibidos = {
                    "CodDependencia": V_dependencia,
                    "CodDependenciaOrigen": V_dependenciaOrigen,
                    'CodTipoDocumento': V_tipodocumento,
                    'CodEstado': V_estado,
                    "Inicio": V_fechainicio,
                    "Fin": V_fechafin,
                    "Asunto": V_asunto
                };
            $.ajax({
                type: 'GET',
                url: '_GridRecibidosView',
                data: datos_recibidos,
                contentType: 'application/html',
                dataType: "html",
                success: function (content) {

                    $('#divGridContainer').html(content);

                },
                error: function (e) {
                    alert(e.statusText);
                }
            });
        });

        //    var obj = new Object();
        //    obj.CodDependencia = "AAA";
        //    obj.IdEstado = 500;

        //    var pFiltro = {
        //        CodDependencia: $("#cbxDependencia option:selected").val(),
        //        IdEstado: 100
        //    }

        //    var params = JSON.stringify(obj);

        //    $.ajax({
        //        type: 'GET',
        //        url: '_GridRecibidosView',
        //        data: {
        //            CodDependencia: $("#cbxDependencia option:selected").val(),
        //            CodDependenciaOrigen: $("#cbxDependenciaOrigen option:selected").val(),
        //            CodTipoDocumento: $("#cbxTipoDocumento option:selected").val(),
        //            FechaInicio: $("#dpFechaInicio").val(),
        //            FechaFin: $("#dpFechaFin").val(),
        //            CodEstado: $("#cbxEstado").val(),
        //            TipoEmision: $("#cbxTipoEmision").val(),
        //            TextoFiltro: $("#txtBusqueda").val()
        //        },
        //        contentType: 'application/html',
        //        //data: JSON.stringify(model),
        //        dataType: "html",
        //        success: function (content) {
        //            $('#divGridContainer').html(content);
        //        },
        //        error: function (e) {
        //            alert(e.statusText);
        //        }
        //    });

    });


</script>

<div class="container-fluid">
    <div class="col-md-12">


        <div class="card">
            <div class="card-header">
                <strong><font size=4>Consulta de documentos recibidos</font></strong>
            </div>
            <div class="card-body">

                <div class="form-horizontal" role="form">
                    <div class="row">
                        <input id="CodDependencia" type="hidden" value=@VnombreUsuario />
                        <div class="form-group col-sm-3">
                            <label class="control-label" for="date-input">Dependencia <span class="text-danger" title="Filtro obligatorio">*</span></label>
                            <div class="">
                                @Html.DropDownListFor(x => x._Filtros.CodDependencia, Model.LstDependencias.Select(item => new SelectListItem { Value = item.Codigo, Text = item.Descripcion }),
                                                            htmlAttributes: new { @class = "form-control form-control-md", @id = "cbxDependencia" })
                            </div>
                        </div>
                        <div class="form-group col-sm-3">
                            <label class="control-label" for="date-input">Dependencia de origen<span class="text-danger" title="Filtro obligatorio">*</span></label>
                            <div class="">
                                @Html.DropDownListFor(x => x._Filtros.CodDependenciaOrigen, Model.LstDependenciasOrigen.Select(item => new SelectListItem { Value = item.Codigo, Text = item.Descripcion }),
                                                            "(Todos)", htmlAttributes: new { @class = "form-control form-control-md", @id = "cbxDependenciaOrigen" })
                            </div>
                        </div>
                        <div class="form-group col-sm-3">
                            <label class="control-label" for="date-input">Tipo documento<span class="text-danger" title="Filtro obligatorio">*</span></label>
                            <select class="form-control" id="TipoDocumentoDependencia"></select>

                            @*@Html.DropDownListFor(x=>x._Filtros.CodTipoDocumento, Model.LstTipoDocumentos.Select(item => new SelectListItem { Value = item.CodigoTipoDoc, Text = item.Descripcion }),
                                "..Seleccionar..", new { @class = "form-control form-control-md", @id = "cbxTipoDocumento" })*@

                        </div>
                        <div class="form-group col-sm-3">
                            <label class="control-label">Estado</label>
                            @Html.DropDownListFor(x=>x._Filtros.CodEstado, Model.LstEstadosTran.Select(item => new SelectListItem { Value = item.CodigoEstado, Text = item.Descripcion }),
                                                        "(Todos)", new { @class = "form-control form-control-md", @id = "cbxEstado" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-3">
                            <div class="form-group">
                                <label class="control-label" for="date-input">Desde </label>
                                <div class="">
                                    <input id="dpFechaInicio" class="form-control" type="date" />
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-3">
                            <div class="form-group">
                                <label class="control-label" for="date-input">Hasta </label>
                                <div class="">
                                    <input id="dpFechaFin" class="form-control" type="date" />
                                </div>
                            </div>
                        </div>

                        <div class="form-group col-sm-6">
                            <label class="control-label">Asunto / Expediente / Nº Documento </label>
                            <input id="txtBusqueda" type="text" class="form-control" placeholder="Ingresar" />
                        </div>
                    </div>
                </div>


                <div class="row">
                    <div class="col-md-1">
                        <input type="button" id="btnLimpiar" class="btn btn-primary" value="  Limpiar  " />
                    </div>
                    <div class="col-md-1">
                        <input type="button" id="btnConsultar" class="btn btn-primary" value="Consultar" />
                    </div>

                </div>


            </div>
        </div>

        <div class="card">

            <div id="divGridContainer">
            </div>


        </div>
    </div>
</div>