        function documentos_generados(ln_tiempo) {

            switch (ln_tiempo) {
                case 1:
                    mostrar_generados_por_dia();
                    $("#tiempo_grafico").html('<font size = "2">Últimos 7 días</font>');
                    mostrar_procentajes_dia_memo();

                    break;
                case 2:
                    mostrar_generados_por_mes();
                    $("#tiempo_grafico").html('<font size = "2">Últimos 30 días</font>');
                    mostrar_procentajes_mes();
                    break;

                case 3:
                    mostrar_generados_por_anio();
                    $("#tiempo_grafico").html('<font size="2">Últimos 12 meses</font>');
                    mostrar_procentajes_anio();
                    break;
                default:
                    break;
            }

        }


        function mostrar_generados_por_dia() {
            $.ajax({
            type: 'GET',
            url: '@Url.Action("_GeneradoDia", "Dashboard")',
            contentType: 'application/json;charset=utf-8',
            dataType: "json",
                success: function (data) {
                var xValuesMes = [];
                var yValuesTotal = [];
                for (let index = 0; index < data.length; index++) {
                xValuesMes.push(data[index].I_dia);
                yValuesTotal.push(data[index].I_total);
                }
            GraficoGenerado(xValuesMes, yValuesTotal, "line");
                },
            error: function (e) {
            alert(e.statusText);
            }
        });
